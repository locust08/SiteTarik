# Public values exposed to the browser bundle.
NEXT_PUBLIC_SITE_URL=https://sitetarik.com
NEXT_PUBLIC_GTM_ID=GTM-5F3MLDMN
# Real GA4 web measurement ID for SiteTarik.
# This is distinct from the GA4 property reference 534874257.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-2RV95WLNQ2

# Server-only values. Keep these out of client code and set them as Cloudflare secrets in production.
STRIPE_SECRET_KEY=
# Doppler live-mode value. When present, this is preferred over STRIPE_SECRET_KEY.
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
DELIVERY_ALERT_FROM_EMAIL=
DELIVERY_ALERT_TO_EMAIL=ava@locus-t.com.my
