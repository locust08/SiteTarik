{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sitetarik",
  "account_id": "e7c515dde995479daacd82ad79dfc3e8",
  // Keep NEXT_PUBLIC_* values in your Cloudflare Worker environment.
  // Add server-only values with `wrangler secret put <NAME>` instead of committing them here:
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY,
  // DELIVERY_ALERT_FROM_EMAIL, DELIVERY_ALERT_TO_EMAIL.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://sitetarik.com",
    "NEXT_PUBLIC_GTM_ID": "GTM-5F3MLDMN",
    "NEXT_PUBLIC_GA4_MEASUREMENT_ID": "G-2RV95WLNQ2"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "sitetarik_cms",
      "database_name": "sitetarik-cms",
      "database_id": "6e71730b-9ece-46ac-b747-8045c953a67f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "sitetarik_cms_images",
      "bucket_name": "sitetarik-cms-images"
    }
  ],
  "routes": [
    {
      "pattern": "sitetarik.com/*",
      "zone_name": "sitetarik.com"
    },
    {
      "pattern": "www.sitetarik.com/*",
      "zone_name": "sitetarik.com"
    }
  ]
}
